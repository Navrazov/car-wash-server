{
  "name": "car-wash-server",
  "version": "2.0.0",
  "description": "Backend API для сервиса автомойки",
  "main": "index.ts",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node --transpile-only -r tsconfig-paths/register ./index.ts",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "create-admin": "ts-node -r tsconfig-paths/register scripts/createAdmin.ts",
    "migrate-ratings": "ts-node -r tsconfig-paths/register scripts/migrateUserRatings.ts"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.1",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^11.0.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.9",
    "@types/uuid": "^10.0.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.6.2"
  }
}
